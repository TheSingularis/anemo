<Window x:Class="Anemo.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anemo Widget" Width="300" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="NoResize" Topmost="True"
        WindowStartupLocation="Manual" Background="#202020"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="RowLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="0,3,12,3"/>
        </Style>

        <Style x:Key="RowValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3A7EE0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A8CEB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2E6BC4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#3D3D3D"/>
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                                  Width="10" Height="10"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1707A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AdapterComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                   Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                   TextElement.Foreground="#EEEEEE"/>
                                                <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#9A9A9A" StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Width="8" Height="4" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="None"
                                   Width="{TemplateBinding ActualWidth}">
                                <Border Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Padding="2">
                                    <ScrollViewer MaxHeight="160">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#EEEEEE"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="itemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="itemBorder" Property="Background" Value="#3A7EE0"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#3A3A3A" BorderThickness="1">
    <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top" Height="32" Background="#181818" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Anemo Widget" Foreground="#EEEEEE" FontSize="12"
                       VerticalAlignment="Center" Margin="12,0,0,0"/>
            <Button x:Name="btnClose" Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Click"/>
        </Grid>
    <StackPanel Margin="14">
        <StackPanel>
            <TextBlock Text="IP CONFIG" Style="{StaticResource SectionHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Adapter" Style="{StaticResource RowLabelStyle}"/>
                <ComboBox x:Name="cmbAdapter" Grid.Row="0" Grid.Column="1" Style="{StaticResource AdapterComboStyle}"
                          SelectionChanged="cmbAdapter_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Link Speed" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtLinkSpeed" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="IPv4" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtIPv4" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Subnet" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtSubnet" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Gateway" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtGateway" Grid.Row="4" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="DNS" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtDNS" Grid.Row="5" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="MAC" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtMAC" Grid.Row="6" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>
            </Grid>
        </StackPanel>

        <!-- Collapsed entirely (not just blanked out) when WiFi isn't the active
             connection, so it doesn't eat half the window with placeholder dashes. -->
        <StackPanel x:Name="wifiSection" Visibility="Collapsed">
            <Separator Margin="0,10" Background="#3A3A3A"/>
            <TextBlock Text="WI-FI" Style="{StaticResource SectionHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="SSID" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtSSID" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Signal" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtSignal" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="RSSI" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtRSSI" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Channel" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtChannel" Grid.Row="3" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Radio" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtRadio" Grid.Row="4" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>
            </Grid>
        </StackPanel>

        <Separator Margin="0,10" Background="#3A3A3A"/>

        <StackPanel>
            <TextBlock Text="CONNECTIVITY" Style="{StaticResource SectionHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Gateway" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtGatewayPing" Grid.Row="0" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="1.1.1.1" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtInternetPing" Grid.Row="1" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Public IP" Style="{StaticResource RowLabelStyle}"/>
                <TextBlock x:Name="txtPublicIp" Grid.Row="2" Grid.Column="1" Text="-" Style="{StaticResource RowValueStyle}"/>
            </Grid>
        </StackPanel>

        <Separator Margin="0,10" Background="#3A3A3A"/>

        <StackPanel>
            <TextBlock Text="TRAFFIC" Style="{StaticResource SectionHeaderStyle}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Download" Style="{StaticResource RowLabelStyle}"/>
                <Polyline x:Name="sparkDownload" Grid.Row="0" Grid.Column="1" Stroke="#5CB85C" StrokeThickness="1.2"
                          StrokeLineJoin="Round" Height="14" Margin="0,3,10,3" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtDownload" Grid.Row="0" Grid.Column="2" Text="-" Style="{StaticResource RowValueStyle}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Upload" Style="{StaticResource RowLabelStyle}"/>
                <Polyline x:Name="sparkUpload" Grid.Row="1" Grid.Column="1" Stroke="#3A7EE0" StrokeThickness="1.2"
                          StrokeLineJoin="Round" Height="14" Margin="0,3,10,3" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtUpload" Grid.Row="1" Grid.Column="2" Text="-" Style="{StaticResource RowValueStyle}"/>
            </Grid>
        </StackPanel>

        <StackPanel Margin="0,16,0,0">
            <Button x:Name="btnRenew" Content="Release &amp; Renew IP" Height="34" Style="{StaticResource AccentButtonStyle}" Click="btnRenew_Click"/>
            <TextBlock x:Name="txtStatus" Text="" Foreground="#5CB85C" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtUpdated" Text="Last updated: -" Foreground="#666666" FontSize="10" Margin="0,10,0,0" HorizontalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
    </DockPanel>
    </Border>
</Window>
