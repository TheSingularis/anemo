<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Anemo.Widget</AssemblyName>
    <RootNamespace>Anemo.Widget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.5</Version>
    <Company>Jordan</Company>
    <Product>Anemo Widget</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- ManagedNativeWifi is used by Anemo.Core (WifiInfo.cs) and flows through
         via the ProjectReference below - no need to also declare it directly here. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <!-- Run elevated by ElevatedTaskRunner; embedded so the installed copy can be verified
       byte-for-byte against what this build ships. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts\AnemoNetTask.ps1" LogicalName="Anemo.Widget.Scripts.AnemoNetTask.ps1" />
    <EmbeddedResource Include="Scripts\InstallNetTask.ps1" LogicalName="Anemo.Widget.Scripts.InstallNetTask.ps1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Anemo.Core\Anemo.Core.csproj" />
  </ItemGroup>

  <!-- This project's own files sit at the repo root alongside the sibling
       Anemo.Scanner/ and Anemo.Core/ projects, so the default recursive
       glob would otherwise try to compile their sources into this assembly too. -->
  <ItemGroup>
    <Compile Remove="Anemo.Scanner\**" />
    <Compile Remove="Anemo.Core\**" />
    <Compile Remove="Anemo.Core.Tests\**" />
    <Page Remove="Anemo.Scanner\**" />
    <Page Remove="Anemo.Core\**" />
    <ApplicationDefinition Remove="Anemo.Scanner\**" />
    <None Remove="Anemo.Scanner\**" />
    <None Remove="Anemo.Core\**" />
    <None Remove="Anemo.Core.Tests\**" />
  </ItemGroup>

</Project>
