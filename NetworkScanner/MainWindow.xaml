<Window x:Class="NetworkScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Network Scanner" Width="980" Height="640" MinWidth="760" MinHeight="480"
        WindowStyle="None" AllowsTransparency="False" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#202020"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/NetworkWidget.Core;component/Styles/DarkScrollBar.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <SolidColorBrush x:Key="AccentBrush" Color="#3A7EE0"/>
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#3A7EE0" Opacity="0.12"/>
        <SolidColorBrush x:Key="GoodBrush" Color="#5CB85C"/>
        <SolidColorBrush x:Key="BadBrush" Color="#D9534F"/>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Arrow"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1" Width="10" Height="10"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MinMaxButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B5B5B5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="18,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Rectangle x:Name="accent" Width="3" HorizontalAlignment="Left" Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                            <Border x:Name="border" Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#232323"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="accent" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="border" Property="Background" Value="#262626"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PageTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="PageDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="Margin" Value="0,4,0,20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4A8CEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="CaretBrush" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
        </Style>

        <Style x:Key="CellStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="#3A3A3A" BorderThickness="1">
        <DockPanel LastChildFill="True">

            <!-- Title bar -->
            <Grid DockPanel.Dock="Top" Height="36" Background="#181818" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Network Scanner" Foreground="#EEEEEE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  concept preview" Foreground="#6A6A6A" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="btnMinimize" Style="{StaticResource MinMaxButtonStyle}" Click="btnMinimize_Click">
                        <Path Data="M0,0 L10,0" Stroke="#CCCCCC" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="btnMaximize" Style="{StaticResource MinMaxButtonStyle}" Click="btnMaximize_Click">
                        <Path Data="M0,0 L10,0 L10,10 L0,10 Z" Stroke="#CCCCCC" StrokeThickness="1"/>
                    </Button>
                    <Button x:Name="btnClose" Style="{StaticResource CloseButtonStyle}" Click="btnClose_Click"/>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#181818">
                    <StackPanel Margin="0,14,0,0">
                        <Button x:Name="navDashboard" Content="Dashboard" Style="{StaticResource NavButtonStyle}" Tag="selected" Click="Nav_Click"/>
                        <Button x:Name="navDevices" Content="Devices" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                        <Button x:Name="navWifi" Content="Wi-Fi Analyzer" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                        <Button x:Name="navSpeed" Content="Speed Test" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                        <Button x:Name="navPorts" Content="Port Scanner" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                        <Button x:Name="navTraceroute" Content="Traceroute" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                        <Border Height="1" Background="#2A2A2A" Margin="18,10"/>
                        <Button x:Name="navSettings" Content="Settings" Style="{StaticResource NavButtonStyle}" Click="Nav_Click"/>
                    </StackPanel>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="28,24,28,24">

                    <!-- Dashboard -->
                    <ScrollViewer x:Name="pageDashboard" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="At-a-glance overview of your current network status." Style="{StaticResource PageDescStyle}"/>

                            <UniformGrid Columns="4" Rows="1">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="LOCAL IP" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock x:Name="txtDashIp" Text="-" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="GATEWAY" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock x:Name="txtDashGateway" Text="-" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="DEVICES ONLINE" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock x:Name="txtDashDevices" Text="-" Foreground="White" FontSize="16" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="WI-FI SIGNAL" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock x:Name="txtDashWifi" Text="-" Foreground="{StaticResource GoodBrush}" FontSize="16" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="Recent Activity" Foreground="#B5B5B5" FontSize="13" FontWeight="SemiBold" Margin="0,26,0,10"/>
                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <ItemsControl x:Name="activityList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                                                    <DockPanel Margin="16,12">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="#6A6A6A" FontSize="11" Margin="12,0,0,0"/>
                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource CellStyle}" TextWrapping="Wrap"/>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="txtNoActivity" Text="Nothing yet — run a scan or test to see it here." Style="{StaticResource CellStyle}" Foreground="#7A7A7A" Margin="16,12"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Devices -->
                    <ScrollViewer x:Name="pageDevices" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Devices" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Discover and identify devices on your local network via an ARP/ping sweep across your subnet." Style="{StaticResource PageDescStyle}"/>

                            <DockPanel Margin="0,0,0,14">
                                <Button x:Name="btnScanDevices" Content="Scan Network" Style="{StaticResource AccentButtonStyle}" DockPanel.Dock="Right" Click="btnScanDevices_Click"/>
                                <TextBlock x:Name="txtDevicesStatus" Text="Subnet: -" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="IP ADDRESS" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="1" Text="HOSTNAME" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="2" Text="MAC ADDRESS" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="3" Text="VENDOR" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource ColHeaderStyle}"/>
                                    </Grid>
                                    <Border Height="1" Background="#333333"/>
                                    <ItemsControl x:Name="devicesList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="rowBorder" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                                                    <Grid Margin="16,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Ip}" Style="{StaticResource CellStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Hostname}" Style="{StaticResource CellStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Mac}" Style="{StaticResource CellStyle}" Foreground="#9A9A9A"/>
                                                        <TextBlock x:Name="vendorText" Grid.Column="3" Text="{Binding Vendor}" Style="{StaticResource CellStyle}" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="4" Text="Online" Style="{StaticResource CellStyle}" Foreground="{StaticResource GoodBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                        <Setter TargetName="rowBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                        <Setter TargetName="vendorText" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Setter TargetName="vendorText" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Wi-Fi Analyzer -->
                    <ScrollViewer x:Name="pageWifi" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Wi-Fi Analyzer" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Visualize channel usage and signal strength of nearby networks to find the least congested channel." Style="{StaticResource PageDescStyle}"/>

                            <DockPanel Margin="0,0,0,14">
                                <Button x:Name="btnScanWifi" Content="Scan" Style="{StaticResource AccentButtonStyle}" DockPanel.Dock="Right" Click="btnScanWifi_Click"/>
                                <TextBlock x:Name="txtWifiStatus" Text="Not scanned yet" Foreground="#9A9A9A" FontSize="12" VerticalAlignment="Center"/>
                            </DockPanel>

                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="2.4 GHz CHANNEL CONGESTION" Style="{StaticResource ColHeaderStyle}" Margin="0,0,0,14"/>
                                    <Grid Height="120">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="chBar1" Grid.Column="0" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar2" Grid.Column="1" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar3" Grid.Column="2" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar4" Grid.Column="3" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar5" Grid.Column="4" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar6" Grid.Column="5" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar7" Grid.Column="6" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar8" Grid.Column="7" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar9" Grid.Column="8" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar10" Grid.Column="9" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                        <Rectangle x:Name="chBar11" Grid.Column="10" Fill="{StaticResource AccentBrush}" Height="0" VerticalAlignment="Bottom" Margin="6,0"/>
                                    </Grid>
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                            <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="1" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="2" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="3" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="4" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="5" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="6" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="7" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="8" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="8" Text="9" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="9" Text="10" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="10" Text="11" Foreground="#8A8A8A" FontSize="10" HorizontalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock x:Name="txtWifiAdvice" Text="Scan to see channel congestion." Foreground="#9A9A9A" FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Nearby Networks" Foreground="#B5B5B5" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,10"/>
                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="SSID" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="1" Text="CHANNEL" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="2" Text="SIGNAL" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="3" Text="SECURITY" Style="{StaticResource ColHeaderStyle}"/>
                                    </Grid>
                                    <Border Height="1" Background="#333333"/>
                                    <ItemsControl x:Name="networksList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                                                    <Grid Margin="16,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="110"/>
                                                            <ColumnDefinition Width="110"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Ssid}" Style="{StaticResource CellStyle}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Channel}" Style="{StaticResource CellStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding RssiDbm, StringFormat='{}{0} dBm'}" Style="{StaticResource CellStyle}"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Security}" Style="{StaticResource CellStyle}" Foreground="#9A9A9A"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Speed Test -->
                    <ScrollViewer x:Name="pageSpeed" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Speed Test" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Test your connection's download/upload throughput and latency against a nearby server." Style="{StaticResource PageDescStyle}"/>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel HorizontalAlignment="Center" Margin="0,20">
                                    <UniformGrid Columns="3" Rows="1" Width="480">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="DOWNLOAD" Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtDownloadResult" Text="0.0" Foreground="White" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock Text="Mbps" Foreground="#8A8A8A" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="UPLOAD" Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtUploadResult" Text="0.0" Foreground="White" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock Text="Mbps" Foreground="#8A8A8A" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="PING" Style="{StaticResource ColHeaderStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="txtPingResult" Text="--" Foreground="White" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                            <TextBlock Text="ms" Foreground="#8A8A8A" FontSize="11" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </UniformGrid>

                                    <!-- Live throughput trend for whichever phase (download/upload) is
                                         currently running - auto-scaled to the peak seen so far, same
                                         approach as the widget's traffic sparklines. -->
                                    <Border Width="480" Height="70" Margin="0,18,0,0" Background="#1C1C1C" CornerRadius="6">
                                        <Grid Margin="4">
                                            <Polyline x:Name="speedGraph" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                                      StrokeLineJoin="Round" Height="62" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                                            <TextBlock x:Name="txtGraphLabel" Text="" Foreground="#6A6A6A" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,4,0,0"/>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="btnStartSpeedTest" Content="Start Test" Style="{StaticResource AccentButtonStyle}" Width="140" Margin="0,20,0,0" Click="btnStartSpeedTest_Click"/>
                                    <TextBlock x:Name="txtSpeedStatus" Text="" Foreground="#9A9A9A" FontSize="11" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Port Scanner -->
                    <ScrollViewer x:Name="pagePorts" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Port Scanner" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Scan a host for open TCP ports to check what services it's exposing." Style="{StaticResource PageDescStyle}"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtPortTarget" Grid.Column="0" Text="192.168.1.1" Style="{StaticResource FieldTextBoxStyle}" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                                <TextBox x:Name="txtPortFrom" Grid.Column="1" Text="1" Style="{StaticResource FieldTextBoxStyle}" VerticalContentAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="–" Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtPortTo" Grid.Column="3" Text="1024" Style="{StaticResource FieldTextBoxStyle}" VerticalContentAlignment="Center"/>
                                <Button x:Name="btnScanPorts" Grid.Column="5" Content="Scan" Style="{StaticResource AccentButtonStyle}" Click="btnScanPorts_Click"/>
                            </Grid>

                            <TextBlock x:Name="txtPortsStatus" Text="" Foreground="#9A9A9A" FontSize="12" Margin="0,-8,0,14"/>

                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PORT" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="1" Text="SERVICE" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="2" Text="STATUS" Style="{StaticResource ColHeaderStyle}"/>
                                    </Grid>
                                    <Border Height="1" Background="#333333"/>
                                    <ItemsControl x:Name="portsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                                                    <Grid Margin="16,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Port}" Style="{StaticResource CellStyle}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Service}" Style="{StaticResource CellStyle}" Foreground="#9A9A9A"/>
                                                        <TextBlock Grid.Column="2" Text="Open" Style="{StaticResource CellStyle}" Foreground="{StaticResource GoodBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Traceroute -->
                    <ScrollViewer x:Name="pageTraceroute" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Traceroute" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Trace the network path to a host, hop by hop. Same engine as the NetworkWidget tray tool." Style="{StaticResource PageDescStyle}"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtTraceTarget" Grid.Column="0" Text="1.1.1.1" Style="{StaticResource FieldTextBoxStyle}" VerticalContentAlignment="Center"/>
                                <Button x:Name="btnRunTrace" Grid.Column="2" Content="Run" Style="{StaticResource AccentButtonStyle}" Click="btnRunTrace_Click"/>
                            </Grid>

                            <TextBlock x:Name="txtTraceStatus" Text="" Foreground="#9A9A9A" FontSize="12" Margin="0,-8,0,14"/>

                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <StackPanel>
                                    <Grid Margin="16,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="HOP" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="1" Text="ADDRESS" Style="{StaticResource ColHeaderStyle}"/>
                                        <TextBlock Grid.Column="2" Text="TIME" Style="{StaticResource ColHeaderStyle}"/>
                                    </Grid>
                                    <Border Height="1" Background="#333333"/>
                                    <ItemsControl x:Name="hopsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#2E2E2E" BorderThickness="0,0,0,1">
                                                    <Grid Margin="16,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="40"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="90"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Hop}" Style="{StaticResource CellStyle}" Foreground="#8A8A8A"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Address}" Style="{StaticResource CellStyle}"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource CellStyle}" Foreground="#9A9A9A" TextAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer x:Name="pageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Preferences for this app." Style="{StaticResource PageDescStyle}"/>

                            <TextBlock Text="Port Scanner Defaults" Foreground="#B5B5B5" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Port range pre-filled when you open the Port Scanner page." Foreground="#8A8A8A" FontSize="12" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtSettingsPortFrom" Grid.Column="0" Style="{StaticResource FieldTextBoxStyle}" VerticalContentAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="–" Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBox x:Name="txtSettingsPortTo" Grid.Column="2" Style="{StaticResource FieldTextBoxStyle}" VerticalContentAlignment="Center"/>
                                        <Button x:Name="btnSaveSettings" Grid.Column="4" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="btnSaveSettings_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="txtSettingsStatus" Text="" Foreground="{StaticResource GoodBrush}" FontSize="11" Margin="0,10,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="About" Foreground="#B5B5B5" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Version" Foreground="#9A9A9A" FontSize="12"/>
                                        <TextBlock x:Name="txtVersion" Grid.Column="1" Text="-" Foreground="#DDDDDD" FontSize="12"/>
                                    </Grid>
                                    <TextBlock Text="Auto-update isn't set up for this app yet — it's still on the roadmap." Foreground="#7A7A7A" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
