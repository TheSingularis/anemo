<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetworkScanner</AssemblyName>
    <RootNamespace>NetworkScanner</RootNamespace>
    <ApplicationIcon>..\app.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Company>Jordan</Company>
    <Product>Network Scanner</Product>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetworkWidget.Core\NetworkWidget.Core.csproj" />
  </ItemGroup>

</Project>
