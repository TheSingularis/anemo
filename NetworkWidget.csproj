<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NetworkWidget</AssemblyName>
    <RootNamespace>NetworkWidget</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.11</Version>
    <Company>Jordan</Company>
    <Product>Network Widget</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- ManagedNativeWifi is used by NetworkWidget.Core (WifiInfo.cs) and flows through
         via the ProjectReference below - no need to also declare it directly here. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NetworkWidget.Core\NetworkWidget.Core.csproj" />
  </ItemGroup>

  <!-- This project's own files sit at the repo root alongside the sibling
       NetworkScanner/ and NetworkWidget.Core/ projects, so the default recursive
       glob would otherwise try to compile their sources into this assembly too. -->
  <ItemGroup>
    <Compile Remove="NetworkScanner\**" />
    <Compile Remove="NetworkWidget.Core\**" />
    <Page Remove="NetworkScanner\**" />
    <Page Remove="NetworkWidget.Core\**" />
    <ApplicationDefinition Remove="NetworkScanner\**" />
    <None Remove="NetworkScanner\**" />
    <None Remove="NetworkWidget.Core\**" />
  </ItemGroup>

</Project>
